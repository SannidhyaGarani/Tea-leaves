# ==============================================================================
# VAARTA CHAI - ENVIRONMENT CONFIGURATION (SERVER-SIDE / VERCEL SECRETS)
# ==============================================================================
# IMPORTANT:
# - These variables are strictly for serverless API routes (under /api/*).
# - NEVER prefix these with VITE_ to prevent client-side exposure.
# - Add these in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# --- SMTP / Email Delivery Settings (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@vaartachai.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="Vaarta Chai" <orders@vaartachai.com>

# --- Administrator Notifications ---
ADMIN_EMAIL=admin@vaartachai.com

# --- Application Public URL (for email buttons & tracking links) ---
SITE_URL=https://vaarta-tea.vercel.app

# --- OTP Cryptographic Hash Salt ---
OTP_SECRET=your_cryptographically_secure_random_string_here

# --- Firebase Admin SDK Credentials (choose Option A OR Option B) ---
# Option A (Recommended for Vercel): Full JSON Service Account string
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# Paste the raw JSON string or Base64 encoded JSON string below:
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"vaarta-bbc3f",...}'

# Option B: Individual Service Account fields (alternative)
# FIREBASE_PROJECT_ID=vaarta-bbc3f
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@vaarta-bbc3f.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
